                <Property Name="onRoadPrice" Type="Edm.Decimal" Precision="13" Scale="2"/>
                <Property Name="exShowroom" Type="Edm.Decimal" Precision="13" Scale="2"/>
                <Property Name="diffAmount" Type="Edm.Decimal" Precision="13" Scale="2"/>
