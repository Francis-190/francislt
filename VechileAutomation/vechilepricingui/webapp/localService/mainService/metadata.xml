                <Property Name="basicPrice" Type="Edm.Decimal" Precision="13" Scale="2"/>
                <Property Name="gstAmount" Type="Edm.Decimal" Precision="13" Scale="2"/>
                <Property Name="keralaCess" Type="Edm.Decimal" Precision="13" Scale="2"/>
                <Property Name="exShowroomPrice" Type="Edm.Decimal" Precision="13" Scale="2"/>
                <Property Name="exceptionRef" Type="Edm.String" MaxLength="50"/>
                <Property Name="rtoPercent" Type="Edm.Decimal" Precision="5" Scale="2"/>
                <Property Name="rtoAmount" Type="Edm.Decimal" Precision="13" Scale="2"/>
                <Property Name="rtoWithBill" Type="Edm.Decimal" Precision="13" Scale="2"/>
                <Property Name="insuranceBelow350" Type="Edm.Decimal" Precision="13" Scale="2"/>
                <Property Name="insuranceAbove350" Type="Edm.Decimal" Precision="13" Scale="2"/>
                <Property Name="insuranceAmount" Type="Edm.Decimal" Precision="13" Scale="2"/>
                <Property Name="tpaPa" Type="Edm.Decimal" Precision="13" Scale="2"/>
