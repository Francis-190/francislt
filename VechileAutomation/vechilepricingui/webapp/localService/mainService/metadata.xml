                <Property Name="state" Type="Edm.String"/>
                <Property Name="exShowroomPrice" Type="Edm.Decimal" Precision="13" Scale="2"/>
                <Property Name="onRoadPrice" Type="Edm.Decimal" Precision="13" Scale="2"/>
            </ComplexType>
            <Action Name="uploadExcel" IsBound="false">
                <Parameter Name="file" Type="Edm.Binary"/>
                <Parameter Name="fileName" Type="Edm.String"/>
                <ReturnType Type="Edm.String"/>
            </Action>
            <Action Name="sendToBPA" IsBound="false">
                <Parameter Name="data" Type="csvtohana.srv.BikePricingService.BpaPricingContext"/>
                <ReturnType Type="Edm.String"/>
            </Action>
            <Annotations Target="csvtohana.srv.BikePricingService.BikePricing/ID">
                <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
            </Annotations>
        </Schema>
    </edmx:DataServices>
</edmx:Edmx>